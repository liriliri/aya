{
  "name": "aya",
  "productName": "AYA",
  "desktopName": "AYA",
  "appId": "io.liriliri.aya",
  "version": "1.14.2",
  "description": "Android adb desktop app",
  "homepage": "https://aya.liriliri.io/",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\"",
    "dev:main": "vite build --watch --config vite.main.mts --mode=development",
    "dev:preload": "vite build --watch --config vite.preload.mts --mode=development",
    "dev:renderer": "vite",
    "build:main": "vite build --config vite.main.mts",
    "build:preload": "vite build --config vite.preload.mts",
    "build:renderer": "vite build",
    "build": "zx script/build.mjs",
    "pack": "zx script/pack.mjs",
    "pack:pacman": "zx script/pack.mjs --pacman",
    "repack:appimage": "node script/repack-appimage.mjs",
    "pack:mas-dev": "zx script/pack.mjs --mas-dev",
    "pack:mas": "zx script/pack.mjs --mas",
    "pack:appx": "zx script/pack.mjs --appx",
    "adb": "zx script/adb.mjs",
    "scrcpy": "zx script/scrcpy.mjs",
    "server": "zx script/server.mjs",
    "format": "lsla prettier \"src/**/*.{ts,tsx,scss,css,json}\" \"*.{js,ts,json}\" \"script/*.mjs\" --write",
    "start": "electron ./dist/main/index.js --inspect=9229",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"script/**/*.{mjs,js}\" \"*.js\" \"*.mts\"",
    "gen:icon": "lsla genIcon --input src/renderer/ --output src/renderer/icon.css --name aya-icon --source src/renderer/icon/",
    "gen:theme": "lsla genTheme --input src/common/theme.json --output src/renderer/theme.scss && lsla genTheme --input src/common/theme.json --output src/common/theme.ts",
    "gen:pb": "pbjs -t static-module -w es6 -o src/main/lib/wire.js server/server/src/main/proto/wire.proto && pbts -o src/main/lib/wire.d.ts src/main/lib/wire.js"
  },
  "keywords": [
    "adb"
  ],
  "author": "surunzi",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@devicefarmer/adbkit": "^3.3.9",
    "@eslint/js": "^10.0.1",
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xmldom/xmldom": "^0.9.12",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@yume-chan/no-data-view": "^2.0.0",
    "@yume-chan/pcm-player": "^1.0.0",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "@yume-chan/stream-extra": "^2.6.1",
    "android-device-list": "^1.2.10",
    "axios": "^1.20.0",
    "blueimp-md5": "^2.19.0",
    "concurrently": "^10.0.6",
    "custom-electron-titlebar": "4.4.1",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "js-yaml": "^5.4.3",
    "licia": "^1.49.0",
    "luna-command-palette": "^0.3.1",
    "luna-data-grid": "2.0.2",
    "luna-dom-viewer": "^1.8.4",
    "luna-file-list": "0.5.6",
    "luna-icon-list": "^0.2.12",
    "luna-image-viewer": "^1.1.0",
    "luna-logcat": "^0.6.3",
    "luna-menu": "^0.2.0",
    "luna-modal": "^1.3.3",
    "luna-music-player": "^1.0.0",
    "luna-music-visualizer": "^0.2.1",
    "luna-notification": "^0.3.3",
    "luna-otp-input": "^0.1.1",
    "luna-path-bar": "^0.3.0",
    "luna-performance-monitor": "^1.2.2",
    "luna-setting": "^2.0.2",
    "luna-split-pane": "^0.4.1",
    "luna-tab": "^0.4.3",
    "luna-text-viewer": "^0.3.0",
    "luna-toolbar": "^0.9.2",
    "luna-video-player": "^1.1.5",
    "luna-virtual-list": "^0.1.1",
    "mediabunny": "^1.61.3",
    "mobx": "^7.0.6",
    "mobx-react-lite": "^5.1.0",
    "protobufjs": "^8.8.0",
    "protobufjs-cli": "^2.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "xml2js": "^0.6.2",
    "zx": "^8.8.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "electron-winstaller@5.4.0": true
  }
}
